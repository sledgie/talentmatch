# Copy this file to .env (or .env.local) and fill in your real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

VITE_ANALYSIS_API_URL=https://your-api.example.com/analyze

# HTTP Basic Auth credentials for the endpoint above
VITE_ANALYSIS_API_USERNAME=your-username
VITE_ANALYSIS_API_PASSWORD=your-password
